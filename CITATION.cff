repository-code: "https://gitlab.com/bart-turczynski/pagerankr"
repository: "https://CRAN.R-project.org/package=pagerankr"
url: "https://bart-turczynski.gitlab.io/pagerankr/"
license: MIT
identifiers:
  - type: doi
    value: 10.5281/zenodo.23046334
    description: >-
      Concept DOI (all deposited versions). Deposits are minted by Zenodo's
      GitHub integration from a Release on the read-only GitHub mirror, and
      this DOI resolves to the latest one.
  - type: doi
    value: 10.5281/zenodo.23046335
    description: "Version DOI for pagerankr 0.1.0"
keywords:
  - PageRank
  - link graph
  - SEO
  - redirect resolution
