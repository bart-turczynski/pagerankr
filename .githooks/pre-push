#!/usr/bin/env bash
# Pre-push verify gate — a local APPROXIMATION of the GitHub-hosted `Verify` and
# `news-version` workflows, both of which run remotely on every push to main and
# every pull request. This is defense-in-depth, not a stand-in: catching a red
# result here costs seconds instead of a round trip through Actions, and it also
# covers a push made with remote CI unavailable.
#
# It is NOT a faithful mirror, and a green here does not prove a green on CI or
# at CRAN. Known divergences:
#   * Dependencies resolve from the LOCAL library. CI installs the DESCRIPTION
#     `Remotes:` targets fresh, so an out-of-date local rurl quietly makes this
#     gate weaker than CI's — the very failure mode step 3 exists to catch. The
#     non-gating notice below reports that skew when it can;
#     `Rscript -e 'pak::local_install_dev_deps()'` clears it.
#   * `qpdf` is often not installed locally, and without it `R CMD check` SKIPS
#     the tarball / PDF size checks that CRAN does run. `brew install qpdf`
#     arms them.
#
# Checks, cheapest first:
#   1. news-version.yaml : top NEWS.md heading vs DESCRIPTION Version
#   2. Verify / lint     : lintr::lint_package() (fails on any lint)
#   3. R CMD check       : rcmdcheck --as-cran, FAILS ON ERRORS AND WARNINGS
#                          (the package is warning-clean; the sole allowed NOTE
#                          is the CRAN-incoming dev-version/Remotes one).
# Between steps 1 and 2, one non-gating notice: installed rurl vs the version
# the `Remotes:` target declares. It warns, never fails, and skips itself when
# curl is missing or the network is unreachable.
#
# Step 3 is what catches correctness regressions — e.g. a dependency bump that
# turns test fixtures red (see PR #50: rurl 2.1.0 emptied bare-label graphs and
# slipped in because remote CI was billing-disabled). It needs the full Suggests
# set (covr, goodpractice, DT, visNetwork, rcmdcheck, ...). When that toolchain
# is NOT installed, step 3 is SKIPPED with a warning rather than failing, so a
# fresh clone still gets the light gate. Install the Suggests to arm it.
#
# The cross-platform matrix (full-check.yml) and R-hub (rhub.yaml) remain the
# release-tag / on-demand path.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Emergency bypass:        SKIP_VERIFY=1 git push
# Skip only R CMD check:   SKIP_RCMDCHECK=1 git push
set -euo pipefail

if [ "${SKIP_VERIFY:-}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY=1 set — skipping the verify gate" >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 1. NEWS / DESCRIPTION version consistency (mirrors news-version.yaml).
echo "pre-push: NEWS/version consistency ..." >&2
version="$(grep -E '^Version:' DESCRIPTION | head -n1 | sed -E 's/^Version:[[:space:]]*//')"
heading="$(grep -m1 -E '^# ' NEWS.md | sed -E 's/^#[[:space:]]+pagerankr[[:space:]]*//')"
if [ "$heading" != "(development version)" ] && [ "$heading" != "$version" ]; then
  echo "pre-push: top NEWS.md heading ('$heading') is neither '(development version)'" >&2
  echo "          nor the DESCRIPTION Version ('$version'). Update NEWS.md." >&2
  exit 1
fi

# Dependency-skew notice (NON-GATING — warns, never fails). Steps 2-3 resolve
# rurl from the local library; CI installs the DESCRIPTION `Remotes:` target
# fresh. Compare the two so a stale local copy cannot masquerade as CI-green.
# Every command here is guarded: a missing curl, a private/renamed repo or no
# network downgrades this to a one-line skip notice.
echo "pre-push: installed rurl vs the Remotes target ..." >&2
rurl_spec="$(awk '
  /^Remotes:/ { line = $0; sub(/^Remotes:/, "", line); inblock = 1; print line; next }
  inblock && /^[[:space:]]/ { print; next }
  inblock { exit }
' DESCRIPTION | tr ',' '\n' |
  grep -oE '[A-Za-z0-9_.-]+/rurl(@[A-Za-z0-9_./-]+)?' | head -n1 || true)"
rurl_repo="${rurl_spec%%@*}"
rurl_ref="HEAD"
case "$rurl_spec" in *@*) rurl_ref="${rurl_spec#*@}" ;; esac

rurl_target=""
if [ -z "$rurl_spec" ]; then
  echo "pre-push:   no rurl entry in DESCRIPTION Remotes — nothing to compare." >&2
elif ! command -v curl >/dev/null 2>&1; then
  echo "pre-push:   curl unavailable — skipping the skew notice." >&2
else
  rurl_target="$(curl -fsL --max-time 5 \
    "https://raw.githubusercontent.com/$rurl_repo/$rurl_ref/DESCRIPTION" 2>/dev/null |
    grep -m1 -E '^Version:' | sed -E 's/^Version:[[:space:]]*//' || true)"
  if [ -z "$rurl_target" ]; then
    echo "pre-push:   could not read $rurl_repo@$rurl_ref (offline?) — skipping the" >&2
    echo "            skew notice." >&2
  fi
fi

if [ -n "$rurl_target" ]; then
  rurl_behind="$(RURL_TARGET="$rurl_target" Rscript -e 'v <- tryCatch(as.character(utils::packageVersion("rurl")), error = function(e) NULL); if (!is.null(v) && utils::compareVersion(v, Sys.getenv("RURL_TARGET")) < 0) cat(v)' 2>/dev/null || true)"
  if [ -n "$rurl_behind" ]; then
    echo "pre-push: ------------------------- WARNING -------------------------" >&2
    echo "pre-push: installed rurl $rurl_behind is BEHIND the Remotes target" >&2
    echo "          $rurl_repo@$rurl_ref ($rurl_target), which is what CI and every" >&2
    echo "          fresh install resolve. The checks below run against the OLD" >&2
    echo "          copy, so passing here does NOT imply passing on CI (see the" >&2
    echo "          PR #50 note in this file's header). Refresh with:" >&2
    echo "            Rscript -e 'pak::local_install_dev_deps()'" >&2
    echo "pre-push: -----------------------------------------------------------" >&2
  fi
fi

# 2. Lint (mirrors the Verify `lint` job; fails on any lint).
echo "pre-push: lintr::lint_package() ..." >&2
Rscript -e 'l <- lintr::lint_package(); if (length(l)) { print(l); quit(status = 1L) }'

# 3. R CMD check (mirrors the Verify `check` job) — fails on errors AND
#    warnings. Skipped (not failed) when rcmdcheck / the Suggests toolchain is
#    unavailable, so a fresh clone still benefits from steps 1-2.
if [ "${SKIP_RCMDCHECK:-}" = "1" ]; then
  echo "pre-push: SKIP_RCMDCHECK=1 set — skipping R CMD check" >&2
elif ! Rscript -e 'quit(status = if (requireNamespace("rcmdcheck", quietly = TRUE)) 0L else 1L)' >/dev/null 2>&1; then
  echo "pre-push: rcmdcheck not installed — skipping R CMD check (install the" >&2
  echo "          package Suggests to arm the full local gate)." >&2
else
  echo "pre-push: R CMD check (--as-cran; fails on errors + warnings) ..." >&2
  Rscript -e 'q <- rcmdcheck::rcmdcheck(args = c("--no-manual", "--as-cran"), error_on = "warning", quiet = TRUE)'
fi

echo "pre-push: verify gate passed ✓" >&2
