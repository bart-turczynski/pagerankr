^.*\.Rproj$
^\.Rproj\.user$
^\.git$
^\.github$
^\.gitlab-ci\.yml$
# The GitLab CI dependency library. Cache paths must live inside
# CI_PROJECT_DIR, so the library sits in the package directory and `R CMD build`
# would otherwise sweep it into the tarball — which fails the check with a
# long-paths WARNING from vendored JS in DT and Rcpp.
^\.cache$
# R CMD check output, written into the project directory so a failed CI job can
# upload it as an artifact.
^check$
^\.githooks$
^\.gitignore$
^\.Rbuildignore$
^README\.Rmd$
^instructions\.md$
^cran-comments\.md$
^CONTRIBUTING\.md$
^CODE_OF_CONDUCT\.md$
^SECURITY\.md$
^SECURITY-INSIGHTS\.yml$
^\.bestpractices\.json$
^LICENSE\.md$
# Add any other files/directories specific to your development process
# that should not be in the package tarball.
^data-raw$
^\.claude$
^covr_report\.html$
^docs$
^lib$
^\.lintr$
^CLAUDE\.md$
^FP_CLAUDE\.md$
^FP_AGENTS\.md$
^AGENTS\.md$
^\.fp$
^_scratch$
^notes$
^worklog$
^ACKNOWLEDGMENTS\.md$
^_pkgdown\.yml$
^codemeta\.json$
^CITATION\.cff$
^\.zenodo\.json$
^tmp$
# The citation gate ported from seor (design/adr/0002 there). Not part
# of the installable package; without this, --as-cran reports it as a
# non-standard top-level directory.
^scripts$
